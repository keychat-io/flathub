      "packages/keychat_rust_ffi_plugin"
    ],
    "extra_pubspecs": [
      "packages/keychat_rust_ffi_plugin/cargokit/build_tool"
    ],
    "manifest": {
      "sources": [
        {
          "type": "patch",
          "path": "cargokit/run_build_tool.sh.patch",
